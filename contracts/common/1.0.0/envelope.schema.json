{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventEnvelope",
  "description": "Reference transport envelope, not a claim that a broker or production publisher exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "occurred_at", "data"],
  "properties": {
    "id": {"$ref": "uuid.schema.json"},
    "type": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
    "source": {"type": "string", "minLength": 1},
    "occurred_at": {"$ref": "timestamp.schema.json"},
    "trace": {"$ref": "trace.schema.json"},
    "data": {"type": "object"}
  }
}
